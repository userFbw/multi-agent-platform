# ============================================================================
# AI 原生全栈应用开发平台 —— Git 忽略规则
#
# 原则：只提交"人写的东西"（源码、技能提示词、文档、依赖清单），
#       不提交"跑出来的东西"（数据库、生成的项目、ZIP、日志、依赖目录、环境变量）。
#
# 注意：backend/data/ 和 backend/exports/ 这两处**不能整目录删掉**，
#        main.py 里有 `app.mount(StaticFiles(directory=...))`，
#       Starlette 挂载时目录不存在会直接报错起不来。
#       所以下面用「忽略内容 + 白名单 .gitkeep」，保证目录本身留在仓库里。
# ============================================================================


# ---------------------------------------------------------------------------
# 环境变量 / 配置（含对外主机名、超时阈值；换机器要改，不该跟着仓库走）
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example


# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境。Readme 里的 new_venv/ 是服务器上跑的那套（也是 Agent 沙箱里的
# python3），体积大、跟平台绑定，不进仓库；换机器按 requirements.txt 重建。
new_venv/
.venv/
venv/
env/
ENV/


# ---------------------------------------------------------------------------
# 前端
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache


# ---------------------------------------------------------------------------
# 平台运行时数据（都在 backend/data/ 下）
#   project.db  = SQLite，演示账号和密码是明文存的，绝对不能传
#   images/     = 用户上传的头像
# ---------------------------------------------------------------------------
backend/data/*
!backend/data/.gitkeep
!backend/data/images/
backend/data/images/*
!backend/data/images/.gitkeep

# 兜底：任何位置的 SQLite 文件
*.db
*.db-journal
*.sqlite
*.sqlite3


# ---------------------------------------------------------------------------
# 生成的项目产物（backend/exports/u<用户>/p<项目>/）
#   源码、PRD、运行日志（.md）、应用日志（.log）、打包的 ZIP 全在这里，
#   是平台跑出来的结果，不是源码。ZIP 下载走服务器本地文件即可。
# ---------------------------------------------------------------------------
backend/exports/*
!backend/exports/.gitkeep


# ---------------------------------------------------------------------------
# 日志 / 临时文件
# ---------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak

# DSH 会话轨迹（默认落在 ~/.dsh/sessions，正常不在仓库里；
# 万一有人把 DSH_HOME 指到仓库内，这几条兜底）
.dsh/sessions/
*.jsonl.zstd


# ---------------------------------------------------------------------------
# 编辑器 / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.claude/


# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.stackdump
